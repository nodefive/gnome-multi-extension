    <key name="workspaces-popup" type="b"><default>true</default><summary>Workspace switch popup</summary></key>

    <!-- Windows -->
    <key name="windows-switcher-popup-delay" type="b"><default>true</default><summary>Switcher popup delay</summary></key>
    <key name="windows-alt-tab-icon-size" type="i"><range min="0" max="512"/><default>0</default><summary>Alt+Tab app icon size</summary><description>0 uses the default</description></key>
    <key name="windows-alt-tab-small-icon-size" type="i"><range min="0" max="512"/><default>0</default><summary>Alt+Tab small app icon size</summary><description>0 uses the default</description></key>
    <key name="windows-alt-tab-window-preview-size" type="i"><range min="0" max="512"/><default>0</default><summary>Alt+Tab window preview size</summary><description>0 uses the default</description></key>
