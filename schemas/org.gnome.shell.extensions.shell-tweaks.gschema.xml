    <key name="windows-demands-attention-focus" type="b"><default>false</default><summary>Focus windows that demand attention</summary></key>
    <key name="windows-maximized-on-create" type="b"><default>false</default><summary>Maximize new windows</summary></key>
    <key name="windows-restore-alt-f5" type="b"><default>false</default><summary>Keep Alt+F5 on unmaximize</summary><description>Puts Alt+F5 back when the unmaximize shortcut is cleared</description></key>

