    <key name="shell-osd-position" type="i"><range min="0" max="9"/><default>0</default><summary>On-screen display position</summary><description>0 default; 1-3 top, 4-6 bottom, 7-9 middle (start, center, end)</description></key>
    <key name="shell-notification-banner-position" type="i"><range min="0" max="5"/><default>1</default><summary>Notification banner position</summary><description>0-2 top, 3-5 bottom (start, center, end)</description></key>
