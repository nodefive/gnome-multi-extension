    <key name="hot-corners-panel-menu" type="b"><default>false</default><summary>Panel menu</summary></key>
    <key name="hot-corners-barrier-size-h" type="i"><range min="1" max="100"/><default>1</default><summary>Horizontal barrier size (percent of width)</summary></key>
    <key name="hot-corners-barrier-size-v" type="i"><range min="1" max="100"/><default>1</default><summary>Vertical barrier size (percent of height)</summary></key>
    <key name="hot-corners-pressure-threshold" type="i"><range min="25" max="800"/><default>100</default><summary>Pressure threshold</summary></key>
    <key name="hot-corners-action-delay" type="i"><range min="0" max="2000"/><default>100</default><summary>Minimum time between actions (ms)</summary></key>
    <key name="hot-corners-corners-visible" type="b"><default>false</default><summary>Show corner barriers (debug)</summary></key>
    <key name="hot-corners-barrier-fallback" type="b"><default>false</default><summary>Use a 3px reactive area instead of pressure barriers</summary></key>
    <key name="hot-corners-top-left-action" type="s"><default>'disabled'</default><summary>Top left: action</summary></key>
    <key name="hot-corners-top-left-command" type="s"><default>''</default><summary>Top left: command</summary></key>
    <key name="hot-corners-top-left-fullscreen" type="b"><default>true</default><summary>Top left: active in fullscreen</summary></key>
    <key name="hot-corners-top-left-ctrl-action" type="s"><default>'disabled'</default><summary>Top left: action with Ctrl</summary></key>
    <key name="hot-corners-top-left-ctrl-command" type="s"><default>''</default><summary>Top left: command with Ctrl</summary></key>
    <key name="hot-corners-top-left-ctrl-fullscreen" type="b"><default>true</default><summary>Top left: Ctrl action active in fullscreen</summary></key>
    <key name="hot-corners-top-right-action" type="s"><default>'disabled'</default><summary>Top right: action</summary></key>
    <key name="hot-corners-top-right-command" type="s"><default>''</default><summary>Top right: command</summary></key>
    <key name="hot-corners-top-right-fullscreen" type="b"><default>true</default><summary>Top right: active in fullscreen</summary></key>
    <key name="hot-corners-top-right-ctrl-action" type="s"><default>'disabled'</default><summary>Top right: action with Ctrl</summary></key>
    <key name="hot-corners-top-right-ctrl-command" type="s"><default>''</default><summary>Top right: command with Ctrl</summary></key>
    <key name="hot-corners-top-right-ctrl-fullscreen" type="b"><default>true</default><summary>Top right: Ctrl action active in fullscreen</summary></key>
    <key name="hot-corners-bottom-left-action" type="s"><default>'disabled'</default><summary>Bottom left: action</summary></key>
    <key name="hot-corners-bottom-left-command" type="s"><default>''</default><summary>Bottom left: command</summary></key>
    <key name="hot-corners-bottom-left-fullscreen" type="b"><default>true</default><summary>Bottom left: active in fullscreen</summary></key>
    <key name="hot-corners-bottom-left-ctrl-action" type="s"><default>'disabled'</default><summary>Bottom left: action with Ctrl</summary></key>
    <key name="hot-corners-bottom-left-ctrl-command" type="s"><default>''</default><summary>Bottom left: command with Ctrl</summary></key>
    <key name="hot-corners-bottom-left-ctrl-fullscreen" type="b"><default>true</default><summary>Bottom left: Ctrl action active in fullscreen</summary></key>
    <key name="hot-corners-bottom-right-action" type="s"><default>'disabled'</default><summary>Bottom right: action</summary></key>
    <key name="hot-corners-bottom-right-command" type="s"><default>''</default><summary>Bottom right: command</summary></key>
    <key name="hot-corners-bottom-right-fullscreen" type="b"><default>true</default><summary>Bottom right: active in fullscreen</summary></key>
    <key name="hot-corners-bottom-right-ctrl-action" type="s"><default>'disabled'</default><summary>Bottom right: action with Ctrl</summary></key>
    <key name="hot-corners-bottom-right-ctrl-command" type="s"><default>''</default><summary>Bottom right: command with Ctrl</summary></key>
    <key name="hot-corners-bottom-right-ctrl-fullscreen" type="b"><default>true</default><summary>Bottom right: Ctrl action active in fullscreen</summary></key>
    <key name="hot-corners-keyboard-shortcuts" type="as"><default>[]</default><summary>Action shortcuts</summary><description>Entries of the form "action accelerator"</description></key>
    <key name="hot-corners-custom-menu-1" type="as"><default>[]</default><summary>Custom menu 1 actions</summary></key>
    <key name="hot-corners-custom-menu-2" type="as"><default>[]</default><summary>Custom menu 2 actions</summary></key>
    <key name="hot-corners-custom-menu-3" type="as"><default>[]</default><summary>Custom menu 3 actions</summary></key>
    <key name="hot-corners-custom-menu-4" type="as"><default>[]</default><summary>Custom menu 4 actions</summary></key>

    <!-- Workspaces -->
    <key name="workspaces-panel-scroll" type="b"><default>false</default><summary>Scroll on the panel to switch workspaces</summary></key>
    <key name="workspaces-scroll-delay" type="i"><range min="0" max="500"/><default>0</default><summary>Minimum time between scroll switches (ms)</summary></key>
    <key name="workspaces-ignore-last" type="b"><default>false</default><summary>Do not scroll into the last workspace</summary><description>Useful with dynamic workspaces</description></key>
